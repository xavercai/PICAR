    static void handleStatus() {
        Gene& g = EvolutionEngine::getCurrentGene();
        String json = "{";
        json += "\"generation\":" + String(EvolutionEngine::getGeneration()) + ",";
        json += "\"individual\":" + String(EvolutionEngine::getIndividual()) + ",";
