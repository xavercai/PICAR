        server.sendHeader("Content-Disposition", "attachment; filename=all_data.csv");
        server.send(200, "text/csv", data);
    }

    static void handleDownloadPopulation() {
        if (!server.hasArg("gen")) {
            server.send(400, "application/json", "{\"error\":\"需要 gen 参数\"}");
            return;
        }
        uint32_t gen = server.arg("gen").toInt();
        if (gen < 1) { server.send(400, "application/json", "{\"error\":\"代数必须 >= 1\"}"); return; }
        
        String path = "/pop_gen_" + String(gen) + ".bin";
        if (!RobustStorage::isReady()) {
            server.send(500, "application/json", "{\"error\":\"SPIFFS不可用\"}");
            return;
        }
        File file = SPIFFS.open(path, FILE_READ);
        if (!file) {
            server.send(404, "application/json", "{\"error\":\"文件不存在: " + path + "\"}");
            return;
        }
        server.sendHeader("Content-Type", "application/octet-stream");
        server.sendHeader("Content-Disposition", "attachment; filename=" + path.substring(1));
        server.streamFile(file, "application/octet-stream");
        file.close();
    }

    static void handleDownloadCurrentPopulation() {
        uint32_t gen = EvolutionEngine::getGeneration();
        if (gen == 0) gen = 1;
        String path = "/pop_gen_" + String(gen) + ".bin";
        if (!RobustStorage::isReady()) {
            server.send(500, "application/json", "{\"error\":\"SPIFFS不可用\"}");
            return;
        }
        if (!SPIFFS.exists(path)) {
            for (uint32_t g = gen; g > 0; g--) {
                String testPath = "/pop_gen_" + String(g) + ".bin";
                if (SPIFFS.exists(testPath)) { path = testPath; break; }
            }
            if (!SPIFFS.exists(path)) {
                for (uint32_t g = 1; g <= gen; g++) {
                    String testPath = "/pop_gen_" + String(g) + ".bin";
                    if (SPIFFS.exists(testPath)) { path = testPath; break; }
                }
            }
        }
        File file = SPIFFS.open(path, FILE_READ);
        if (!file) {
            server.send(404, "application/json", "{\"error\":\"种群文件不存在\"}");
            return;
        }
        server.sendHeader("Content-Type", "application/octet-stream");
        server.sendHeader("Content-Disposition", "attachment; filename=" + path.substring(1));
        server.streamFile(file, "application/octet-stream");
        file.close();
    }

    static void handleDownloadCurrentEvolution() {
        String data = "";
        data += "========================================\n";
        data += "  进化小车数据导出 (v8.9-chaos-v4)\n";
        data += "  导出时间: " + String(millis() / 1000) + "s\n";
        data += "========================================\n\n";
        
        data += "=== 系统信息 ===\n";
        data += "固件版本: " + String(FIRMWARE_VERSION) + "\n";
        data += "SPIFFS状态: " + String(RobustStorage::isReady() ? "已挂载" : "未挂载") + "\n";
        data += "进化代数: " + String(EvolutionEngine::getGeneration()) + "\n";
        data += "当前个体: " + String(EvolutionEngine::getIndividual() + 1) + "/" + String(POPULATION_SIZE) + "\n";
        data += "变异率: " + String(EvolutionEngine::getMutationRate(), 2) + "\n";
        data += "最佳新奇度: " + String(EvolutionEngine::getBestNoveltyEver(), 4) + "\n";
        data += "档案大小: " + String(EvolutionEngine::getArchiveSize()) + "\n";
        data += "卡死检测: 差值>50 或 单轮卡死\n\n";
        
        Gene& g = EvolutionEngine::getCurrentGene();
        data += "=== 当前个体基因 ===\n";
        data += "规则数: " + String(g.ruleCount) + "\n";
        data += "存活时间: " + String(g.survival_time) + "ms\n";
        data += "行驶距离: " + String(g.distance_ticks) + " ticks\n";
        data += "新奇度: " + String(g.noveltyScore, 6) + "\n\n";
        
        data += "=== 编码器状态 ===\n";
        data += "左编码器: " + String(MotorController::getLeftTicks()) + "\n";
        data += "右编码器: " + String(MotorController::getRightTicks()) + "\n";
        data += "编码器差值: " + String(MotorController::getEncoderDiff()) + "\n";
        data += "卡死状态: " + String(MotorController::isStuck() ? "卡死中" : "正常") + "\n";
        data += "脱困状态: " + String(MotorController::isEscapeActive() ? "脱困中" : "空闲") + "\n\n";
        
        data += "=== 历史数据 ===\n";
        data += RobustStorage::getCSVData();
        
        data += "\n=== SPIFFS文件列表 ===\n";
        if (RobustStorage::isReady()) {
            File root = SPIFFS.open("/");
            if (root) {
                while (File file = root.openNextFile()) {
                    data += String(file.name()) + " (" + String(file.size()) + " 字节)\n";
                }
                root.close();
            }
        }
        
        server.sendHeader("Content-Type", "text/plain");
        server.sendHeader("Content-Disposition", "attachment; filename=evolution_data.txt");
        server.send(200, "text/plain", data);
    }

    static void handleListFiles() {
        String json = "{\"files\":[";
        if (RobustStorage::isReady()) {
            File root = SPIFFS.open("/");
            bool first = true;
            while (File f = root.openNextFile()) {
                if (!first) json += ",";
                json += "\"" + String(f.name()) + "\"";
                first = false;
            }
            root.close();
        }
        json += "]}";
        server.send(200, "application/json", json);
    }

    static int getFileCount() {
        if (!RobustStorage::isReady()) return 0;
        File root = SPIFFS.open("/");
        int c = 0;
        while (File f = root.openNextFile()) { c++; }
        root.close();
        return c;
    }

    static void handleNotFound() { server.send(404, "{}"); }
};

WebServer CarWebServer::server(80);

// ================================================================
// WiFi 初始化
// ================================================================
static bool wifiInitialized = false;
static bool wifiReady = false;

void initWiFi() {
    if (wifiInitialized) return;
    wifiInitialized = true;
    WiFi.mode(WIFI_AP);
    if (WiFi.softAP(WIFI_SSID, WIFI_PASSWORD)) {
        wifiReady = true;
        Logger::logf("WiFi AP: %s", WIFI_SSID);
        Logger::logf("IP: %s", WiFi.softAPIP().toString().c_str());
        CarWebServer::init();
    }
}

// ================================================================
// setup()
// ================================================================
void setup() {
    Serial.begin(115200);
    delay(1000);

    Logger::log("========================================");
    Logger::logf("  🧬 进化小车 %s", FIRMWARE_VERSION);
    Logger::log("  (双模式卡死检测 + 完整Web下载)");
    Logger::log("========================================");

    RobustStorage::init();
    if (FirmwareVersionManager::isNewVersion()) {
        FirmwareVersionManager::cleanAllData();
    }

    GeneStorage::init();
    if (GeneStorage::shouldStartNewExperiment()) {
        GeneStorage::startNewExperiment();
    }

    pinMode(PIN_NOISE_SOURCE, INPUT);
    randomSeed(SensorCalibration::readNoise());

    SensorCalibration::calibrate();
    MotorController::init();
    EvolutionEngine::init();

    Logger::log("========================================");
    Logger::logf("  ✅ 就绪 (%s)", FIRMWARE_VERSION);
    Logger::log("  📡 WiFi: CarLogger / 12345678");
    Logger::log("  🌐 http://192.168.4.1");
    Logger::log("  🔄 双模式卡死检测:");
    Logger::log("     - 差值 > 50 持续增大 1秒");
    Logger::log("     - 单轮卡死 持续 1秒");
    Logger::log("========================================");
}

// ================================================================
// loop()
// ================================================================
void loop() {
    if (!wifiInitialized) initWiFi();

    MotorController::updatePhysicsAction();

    if (EvolutionEngine::isTestActive()) {
        Gene& gene = EvolutionEngine::getCurrentGene();
        MotorController::update(gene);
        if (millis() - EvolutionEngine::getTestStartTime() > TEST_DURATION_MS) {
            EvolutionEngine::endCurrentTest();
            EvolutionEngine::nextIndividual();
        }
    }

    if (wifiReady) CarWebServer::handleClient();

    if (EvolutionEngine::getPendingTransition()) {
        EvolutionEngine::clearPendingTransition();
        EvolutionEngine::nextIndividual();
    }

    RobustStorage::tick();
    delay(LOOP_DELAY_MS);
}
